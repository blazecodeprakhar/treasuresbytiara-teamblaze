{% schema %}
{
  "name": "Custom Hero Section",
  "tag": "section",
  "class": "custom-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Heading Here"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your Subheading Here"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "url",
      "id": "section_link",
      "label": "Section Link (Makes Entire Section Clickable)"
    }
  ],
  "presets": [
    {
      "name": "Custom Hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}

<style>
.hero-section {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.hero-section--clickable {
  cursor: pointer;
}

.hero-section__overlay-link {
  position: absolute;
  inset: 0;
  z-index: 2;
}

.hero-section__image {
  width: 100%;
  height: auto;
  display: none;
}

.hero-section__image--desktop {
  display: block;
}

@media screen and (max-width: 749px) {
  .hero-section__image--desktop {
    display: none;
  }
  .hero-section__image--mobile {
    display: block;
  }
}

.hero-section__content {
  position: absolute;
  top: 50%;
  inset-inline: 0;
  transform: translateY(-50%);
  width: 100%;
  text-align: center;
  padding: 1rem clamp(1rem, 4vw, 3rem);
  color: white;
  z-index: 3;
  pointer-events: none;
}

.hero-section__content.start {
  text-align: left;
}

.hero-section__content.end {
  text-align: right;
}

.hero-section__content h1 {
  font-family: var(--font-heading--family, 'Cormorant Garamond', Georgia, serif);
}

.hero-section .btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 4;
  pointer-events: auto;
  padding: 10px 24px;
  border-radius: 999px;
  background-color: var(--color-primary);
  color: var(--color-primary-button-text);
  text-decoration: none;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 0.78rem;
  transition: transform 0.25s ease, background-color 0.25s ease;
}

.hero-section .btn:hover {
  transform: translateY(-2px);
  background-color: var(--color-primary-hover);
}
</style>

{% assign section_link = section.settings.section_link %}

<div class="hero-section{% if section_link != blank %} hero-section--clickable{% endif %}">
  {% if section_link != blank %}
    <a href="{{ section_link }}" class="hero-section__overlay-link" aria-label="{{ section.settings.heading | default: 'Explore collection' | escape }}"></a>
  {% endif %}

  {% if section.settings.desktop_image != blank %}
    <img
      src="{{ section.settings.desktop_image | image_url }}"
      alt="{{ section.settings.heading | default: shop.name | escape }}"
      class="hero-section__image hero-section__image--desktop"
      loading="lazy"
    >
  {% endif %}
  {% if section.settings.mobile_image != blank %}
    <img
      src="{{ section.settings.mobile_image | image_url }}"
      alt="{{ section.settings.heading | default: shop.name | escape }}"
      class="hero-section__image hero-section__image--mobile"
      loading="lazy"
    >
  {% endif %}

  {% if section.settings.heading != blank or section.settings.subheading != blank or (section.settings.button_text != blank and section.settings.button_link != blank) %}
    <div class="hero-section__content {{ section.settings.content_alignment }}">
      {% if section.settings.heading != blank %}
        <h1>{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_text }}</a>
      {% endif %}
    </div>
  {% endif %}
</div>
