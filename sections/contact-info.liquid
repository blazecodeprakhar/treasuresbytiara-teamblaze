{% liquid
  assign phone_raw = section.settings.phone_number | strip
  assign phone_href = phone_raw | remove: ' ' | remove: '-' | remove: '(' | remove: ')'

  assign phone_secondary_raw = section.settings.phone_number_secondary | strip
  assign phone_secondary_href = phone_secondary_raw | remove: ' ' | remove: '-' | remove: '(' | remove: ')'

  assign email_clean = section.settings.email_address | strip
  assign email_secondary_clean = section.settings.email_address_secondary | strip

  assign whatsapp_raw = section.settings.whatsapp_number | strip
  if whatsapp_raw == blank
    assign whatsapp_raw = phone_raw
  endif
  assign whatsapp_digits = whatsapp_raw | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'

  assign address_line_1 = section.settings.address_line_1 | strip
  assign address_line_2 = section.settings.address_line_2 | strip
  assign address_line_3 = section.settings.address_line_3 | strip

  assign full_address_query = address_line_1
  if address_line_2 != blank
    assign full_address_query = full_address_query | append: ', ' | append: address_line_2
  endif
  if address_line_3 != blank
    assign full_address_query = full_address_query | append: ', ' | append: address_line_3
  endif
  assign full_address_query = full_address_query | strip | url_encode

  assign resolved_map_url = section.settings.map_link_url
  if resolved_map_url == blank and full_address_query != blank
    assign resolved_map_url = 'https://www.google.com/maps/search/?api=1&query=' | append: full_address_query
  endif

  assign has_phone = false
  if phone_raw != blank or phone_secondary_raw != blank
    assign has_phone = true
  endif

  assign has_email = false
  if email_clean != blank or email_secondary_clean != blank
    assign has_email = true
  endif

  assign has_address = false
  if address_line_1 != blank or address_line_2 != blank or address_line_3 != blank
    assign has_address = true
  endif

  assign has_hours = false
  if section.settings.hours_title != blank or section.settings.hours_text != blank
    assign has_hours = true
  endif

  assign has_additional = false
  if section.settings.additional_title != blank or section.settings.additional_text != blank
    assign has_additional = true
  endif
%}

{% # theme-check-disable %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
>
{% # theme-check-enable %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  id="ContactInfo-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} contact-info-wrapper"
>
  <div
    class="contact-info spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="contact-info__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="contact-info__eyebrow">
            <span>{{ section.settings.eyebrow | escape }}</span>
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="contact-info__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="contact-info__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if has_phone or has_email or has_address -%}
      <div class="contact-info__grid">
        {%- if has_phone -%}
          <article class="contact-info__card">
            <div class="contact-info__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </div>
            {%- if section.settings.phone_title != blank -%}
              <h3 class="contact-info__card-title">{{ section.settings.phone_title | escape }}</h3>
            {%- endif -%}
            <div class="contact-info__card-body">
              {%- if phone_raw != blank -%}
                <a class="contact-info__link" href="tel:{{ phone_href }}">{{ phone_raw | escape }}</a>
              {%- endif -%}
              {%- if phone_secondary_raw != blank -%}
                <a class="contact-info__link" href="tel:{{ phone_secondary_href }}">{{ phone_secondary_raw | escape }}</a>
              {%- endif -%}
              {%- if section.settings.phone_note != blank -%}
                <p class="contact-info__note">{{ section.settings.phone_note | escape }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}

        {%- if has_email -%}
          <article class="contact-info__card">
            <div class="contact-info__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </div>
            {%- if section.settings.email_title != blank -%}
              <h3 class="contact-info__card-title">{{ section.settings.email_title | escape }}</h3>
            {%- endif -%}
            <div class="contact-info__card-body">
              {%- if email_clean != blank -%}
                <a class="contact-info__link contact-info__link--email" href="mailto:{{ email_clean }}">{{ email_clean | escape }}</a>
              {%- endif -%}
              {%- if email_secondary_clean != blank -%}
                <a class="contact-info__link contact-info__link--email" href="mailto:{{ email_secondary_clean }}">{{ email_secondary_clean | escape }}</a>
              {%- endif -%}
              {%- if section.settings.email_note != blank -%}
                <p class="contact-info__note">{{ section.settings.email_note | escape }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}

        {%- if has_address -%}
          <article class="contact-info__card">
            <div class="contact-info__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </div>
            {%- if section.settings.address_title != blank -%}
              <h3 class="contact-info__card-title">{{ section.settings.address_title | escape }}</h3>
            {%- endif -%}
            <div class="contact-info__card-body">
              <address class="contact-info__address">
                {%- if address_line_1 != blank -%}
                  <span>{{ address_line_1 | escape }}</span>
                {%- endif -%}
                {%- if address_line_2 != blank -%}
                  <span>{{ address_line_2 | escape }}</span>
                {%- endif -%}
                {%- if address_line_3 != blank -%}
                  <span>{{ address_line_3 | escape }}</span>
                {%- endif -%}
              </address>
              {%- if section.settings.address_note != blank -%}
                <p class="contact-info__note">{{ section.settings.address_note | escape }}</p>
              {%- endif -%}
              {%- if resolved_map_url != blank and section.settings.map_link_label != blank -%}
                <a
                  class="contact-info__map-link"
                  href="{{ resolved_map_url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{{ section.settings.map_link_label | escape }}</span>
                  <span class="contact-info__map-arrow" aria-hidden="true">&rarr;</span>
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if has_hours or has_additional -%}
      <div class="contact-info__details-grid{% unless has_hours and has_additional %} contact-info__details-grid--single{% endunless %}">
        {%- if has_hours -%}
          <div class="contact-info__detail-panel">
            <div class="contact-info__detail-header">
              <span class="contact-info__detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
              </span>
              {%- if section.settings.hours_title != blank -%}
                <h3 class="contact-info__detail-title">{{ section.settings.hours_title | escape }}</h3>
              {%- endif -%}
            </div>
            {%- if section.settings.hours_text != blank -%}
              <div class="contact-info__detail-rte rte">{{ section.settings.hours_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if has_additional -%}
          <div class="contact-info__detail-panel">
            <div class="contact-info__detail-header">
              <span class="contact-info__detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 3h12l4 6-10 13L2 9Z" />
                  <path d="M11 3 8 9l4 13 4-13-3-6" />
                  <path d="M2 9h20" />
                </svg>
              </span>
              {%- if section.settings.additional_title != blank -%}
                <h3 class="contact-info__detail-title">{{ section.settings.additional_title | escape }}</h3>
              {%- endif -%}
            </div>
            {%- if section.settings.additional_text != blank -%}
              <div class="contact-info__detail-rte rte">{{ section.settings.additional_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_support_box -%}
      <div class="contact-info__support">
        <div class="contact-info__support-content">
          {%- if section.settings.support_heading != blank -%}
            <h3 class="contact-info__support-heading">{{ section.settings.support_heading | escape }}</h3>
          {%- endif -%}
          {%- if section.settings.support_text != blank -%}
            <div class="contact-info__support-text rte">{{ section.settings.support_text }}</div>
          {%- endif -%}
        </div>

        <div class="contact-info__actions">
          {%- if whatsapp_digits != blank and section.settings.whatsapp_label != blank -%}
            <a
              href="https://wa.me/{{ whatsapp_digits }}"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-info__action contact-info__action--primary"
            >
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                {% render 'icon', icon: 'whatsapp' %}
              </svg>
              <span>{{ section.settings.whatsapp_label | escape }}</span>
            </a>
          {%- endif -%}

          {%- if phone_raw != blank and section.settings.call_label != blank -%}
            <a
              href="tel:{{ phone_href }}"
              class="contact-info__action contact-info__action--outline"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              <span>{{ section.settings.call_label | escape }}</span>
            </a>
          {%- endif -%}

          {%- if email_clean != blank and section.settings.email_label != blank -%}
            <a
              href="mailto:{{ email_clean }}"
              class="contact-info__action contact-info__action--outline"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
              <span>{{ section.settings.email_label | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.map_embed_url != blank -%}
      <div class="contact-info__map-embed">
        <iframe
          src="{{ section.settings.map_embed_url | escape }}"
          title="{{ section.settings.address_title | default: 'Store location map' | escape }}"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  @keyframes contactFadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-info-wrapper {
    overflow-x: clip;
  }

  .contact-info {
    --contact-serif: 'Cormorant Garamond', Georgia, serif;
    --contact-sans: 'Plus Jakarta Sans', var(--font-body--family), sans-serif;
    --contact-ease: cubic-bezier(0.22, 1, 0.36, 1);

    font-family: var(--contact-sans);
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
  }

  .contact-info__header {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .contact-info__eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--contact-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .contact-info__eyebrow::before,
  .contact-info__eyebrow::after {
    content: '';
    width: 24px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-primary));
  }

  .contact-info__eyebrow::after {
    background: linear-gradient(90deg, var(--color-primary), transparent);
  }

  .contact-info__heading {
    margin: 0;
    font-family: var(--contact-serif) !important;
    font-size: clamp(2rem, 3.6vw, 2.85rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.015em;
    color: var(--color-foreground-heading);
  }

  .contact-info__subheading {
    margin: 0;
    font-family: var(--contact-sans);
    font-size: 0.975rem;
    line-height: 1.7;
    color: rgb(from var(--color-foreground) r g b / 0.72);
    max-width: 40rem;
  }

  .contact-info__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .contact-info__card {
    position: relative;
    overflow: hidden;
    background-color: var(--color-input-background);
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 250, 235, 0.45) 100%);
    border: 1px solid rgb(from var(--color-primary) r g b / 0.22);
    border-radius: 22px;
    padding: 36px 28px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 10px 30px rgb(from var(--color-shadow) r g b / 0.05);
    transition:
      transform 0.4s var(--contact-ease),
      border-color 0.4s var(--contact-ease),
      box-shadow 0.4s var(--contact-ease);
  }

  .contact-info__card::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent 8%, #d6a86e 32%, var(--color-primary) 50%, #d6a86e 68%, transparent 92%);
    opacity: 0.75;
    transition: opacity 0.35s ease;
  }

  .contact-info__icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(from var(--color-primary) r g b / 0.3);
    background: linear-gradient(135deg, var(--color-background) 0%, rgb(from var(--color-primary) r g b / 0.14) 100%);
    color: var(--color-primary);
    margin-bottom: 18px;
    box-shadow: 0 6px 16px rgb(from var(--color-primary) r g b / 0.1);
    transition:
      transform 0.4s var(--contact-ease),
      background 0.35s ease,
      color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .contact-info__icon svg {
    width: 24px;
    height: 24px;
  }

  @media (hover: hover) {
    .contact-info__card:hover {
      transform: translateY(-6px);
      border-color: rgb(from var(--color-primary) r g b / 0.52);
      box-shadow: 0 22px 44px rgb(from var(--color-primary) r g b / 0.13);
    }

    .contact-info__card:hover::before {
      opacity: 1;
    }

    .contact-info__card:hover .contact-info__icon {
      transform: scale(1.08);
      background: var(--color-primary);
      border-color: var(--color-primary);
      color: var(--color-primary-button-text);
      box-shadow: 0 10px 22px rgb(from var(--color-primary) r g b / 0.25);
    }
  }

  .contact-info__card-title {
    margin: 0 0 10px;
    font-family: var(--contact-serif) !important;
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: 0.015em;
    line-height: 1.2;
    color: var(--color-foreground-heading);
  }

  .contact-info__card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 100%;
  }

  .contact-info__link {
    font-family: var(--contact-sans);
    font-size: 1.025rem;
    font-weight: 600;
    color: var(--color-foreground);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition:
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .contact-info__link--email {
    word-break: break-word;
  }

  .contact-info__link:hover {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .contact-info__address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-foreground);
    overflow-wrap: anywhere;
  }

  .contact-info__note {
    margin: 6px 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(from var(--color-foreground) r g b / 0.65);
  }

  .contact-info__map-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background-color: rgb(from var(--color-primary) r g b / 0.08);
    font-family: var(--contact-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .contact-info__map-arrow {
    display: inline-block;
    transition: transform 0.25s var(--contact-ease);
  }

  .contact-info__map-link:hover {
    background-color: var(--color-primary);
    color: var(--color-primary-button-text);
  }

  .contact-info__map-link:hover .contact-info__map-arrow {
    transform: translateX(3px);
  }

  .contact-info__details-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .contact-info__details-grid--single {
    grid-template-columns: 1fr;
  }

  .contact-info__detail-panel {
    background-color: var(--color-input-background);
    background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.75) 0%, rgba(255, 250, 235, 0.4) 100%);
    border: 1px solid rgb(from var(--color-primary) r g b / 0.18);
    border-radius: 20px;
    padding: 26px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 8px 24px rgb(from var(--color-shadow) r g b / 0.04);
    transition:
      transform 0.35s var(--contact-ease),
      border-color 0.35s var(--contact-ease),
      box-shadow 0.35s var(--contact-ease);
  }

  @media (hover: hover) {
    .contact-info__detail-panel:hover {
      transform: translateY(-4px);
      border-color: rgb(from var(--color-primary) r g b / 0.45);
      box-shadow: 0 16px 34px rgb(from var(--color-primary) r g b / 0.1);
    }
  }

  .contact-info__detail-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .contact-info__detail-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(from var(--color-primary) r g b / 0.3);
    background: linear-gradient(135deg, var(--color-background) 0%, rgb(from var(--color-primary) r g b / 0.12) 100%);
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .contact-info__detail-icon svg {
    width: 18px;
    height: 18px;
  }

  .contact-info__detail-title {
    margin: 0;
    font-family: var(--contact-serif) !important;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground-heading);
  }

  .contact-info__detail-rte {
    font-family: var(--contact-sans);
    font-size: 0.925rem;
    line-height: 1.7;
    color: rgb(from var(--color-foreground) r g b / 0.84);
  }

  .contact-info__detail-rte p:first-child {
    margin-top: 0;
  }

  .contact-info__detail-rte p:last-child {
    margin-bottom: 0;
  }

  .contact-info__support {
    position: relative;
    overflow: hidden;
    background-color: var(--color-input-background);
    background-image: linear-gradient(135deg, var(--color-input-background) 0%, rgb(from var(--color-primary) r g b / 0.08) 100%);
    border: 1px solid rgb(from var(--color-primary) r g b / 0.32);
    border-radius: 24px;
    padding: 34px 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    box-shadow: 0 14px 36px rgb(from var(--color-shadow) r g b / 0.06);
  }

  .contact-info__support-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 38rem;
  }

  .contact-info__support-heading {
    margin: 0;
    font-family: var(--contact-serif) !important;
    font-size: clamp(1.55rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground-heading);
  }

  .contact-info__support-text {
    font-family: var(--contact-sans);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgb(from var(--color-foreground) r g b / 0.8);
  }

  .contact-info__support-text p {
    margin: 0;
  }

  .contact-info__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    flex-shrink: 0;
  }

  .contact-info__action {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: var(--minimum-touch-target);
    padding: 12px 24px;
    border-radius: 999px;
    font-family: var(--contact-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform 0.3s var(--contact-ease),
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .contact-info__action svg {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
  }

  .contact-info__action--primary {
    background-color: var(--color-primary);
    background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(0, 0, 0, 0.08) 100%);
    color: var(--color-primary-button-text);
    border: 1.5px solid var(--color-primary);
    box-shadow: 0 8px 20px rgb(from var(--color-primary) r g b / 0.22);
  }

  .contact-info__action--primary::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: -120%;
    width: 65%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
    transform: skewX(-20deg);
    transition: inset-inline-start 0.6s var(--contact-ease);
  }

  .contact-info__action--primary:hover::after {
    inset-inline-start: 140%;
  }

  .contact-info__action--primary:hover {
    transform: translateY(-2px);
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    color: var(--color-primary-button-hover-text);
    box-shadow: 0 12px 26px rgb(from var(--color-shadow) r g b / 0.18);
  }

  .contact-info__action--outline {
    background-color: var(--color-input-background);
    color: var(--color-foreground);
    border: 1.5px solid rgb(from var(--color-primary) r g b / 0.5);
  }

  .contact-info__action--outline:hover {
    transform: translateY(-2px);
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-button-text);
    box-shadow: 0 10px 22px rgb(from var(--color-primary) r g b / 0.2);
  }

  .contact-info__map-embed {
    border: 1px solid rgb(from var(--color-primary) r g b / 0.22);
    border-radius: 22px;
    overflow: hidden;
    background-color: var(--color-input-background);
    box-shadow: 0 12px 32px rgb(from var(--color-shadow) r g b / 0.06);
  }

  .contact-info__map-embed iframe {
    display: block;
    width: 100%;
    height: 360px;
    border: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .contact-info__header {
      animation: contactFadeUp 0.65s var(--contact-ease) both;
    }

    .contact-info__card {
      animation: contactFadeUp 0.7s var(--contact-ease) both;
    }

    .contact-info__card:nth-child(1) {
      animation-delay: 0.06s;
    }

    .contact-info__card:nth-child(2) {
      animation-delay: 0.14s;
    }

    .contact-info__card:nth-child(3) {
      animation-delay: 0.22s;
    }

    .contact-info__detail-panel {
      animation: contactFadeUp 0.7s var(--contact-ease) both;
      animation-delay: 0.26s;
    }

    .contact-info__detail-panel:nth-child(2) {
      animation-delay: 0.34s;
    }

    .contact-info__support {
      animation: contactFadeUp 0.75s var(--contact-ease) both;
      animation-delay: 0.38s;
    }
  }

  @media screen and (max-width: 1024px) {
    .contact-info__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-info__grid > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .contact-info__support {
      flex-direction: column;
      text-align: center;
      padding: 28px 24px;
    }

    .contact-info__support-content {
      align-items: center;
    }

    .contact-info__actions {
      justify-content: center;
    }
  }

  @media screen and (max-width: 749px) {
    .contact-info {
      gap: 20px;
    }

    .contact-info__grid,
    .contact-info__details-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .contact-info__grid > :last-child:nth-child(odd) {
      grid-column: auto;
    }

    .contact-info__card,
    .contact-info__detail-panel,
    .contact-info__support {
      padding: 26px 20px;
      border-radius: 18px;
    }

    .contact-info__actions {
      width: 100%;
      flex-direction: column;
    }

    .contact-info__action {
      width: 100%;
    }

    .contact-info__map-embed iframe {
      height: 280px;
    }
  }
{% endstylesheet %}

