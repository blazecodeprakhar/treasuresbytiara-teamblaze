{%- doc -%}
  Renders a contact form with name, email, phone, and comment fields.

  @param {object} settings - Block settings, required for the 'spacing-style' and 'size-style' snippets.
  @param {string} submit_button - HTML for the submit button, rendered via a `content_for` block.

  @example
  {% render 'contact-form', settings: block.settings, submit_button: content_for_submit_button %}
{%- enddoc -%}

{% unless template.suffix == 'contact' %}
  {% # theme-check-disable %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
  >
  {% # theme-check-enable %}
{% endunless %}

<div
  class="
    contact-form
    spacing-style size-style
    {% if settings.inherit_color_scheme == false %}color-{{ settings.color_scheme }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: settings %}
    {% render 'size-style', settings: settings %}
  "
  {{ block.shopify_attributes }}
>
  {% assign form_id = block.id | default: section.id | prepend: 'ContactForm-' %}

  {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
    {%- if form.errors -%}
      <div
        class="contact-form__error"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-error.svg' | inline_asset_content -}}
        <span>
          {{- form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email -}}
        </span>
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? -%}
      <div
        class="contact-form__success"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
        <span>{{- 'blocks.contact_form.post_success' | t -}}</span>
      </div>
    {%- endif -%}

    <div class="contact-form__form-row">
      <div class="contact-form__field">
        <label
          class="contact-form__label"
          for="ContactForm-name"
        >
          {{- 'blocks.contact_form.name' | t -}}
        </label>
        <input
          type="text"
          id="ContactForm-name"
          class="contact-form__input"
          autocomplete="name"
          name="contact[name]"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          placeholder="{{ 'blocks.contact_form.name' | t }}"
        >
      </div>

      <div class="contact-form__field">
        <label
          class="contact-form__label"
          for="ContactForm-email"
        >
          {{- 'blocks.contact_form.email' | t -}}
          <span class="contact-form__required" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="ContactForm-email"
          class="contact-form__input"
          autocomplete="email"
          name="contact[email]"
          spellcheck="false"
          autocapitalize="off"
          required
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          aria-required="true"
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="ContactForm-email-error"
          {% endif %}
          placeholder="{{ 'blocks.contact_form.email' | t }}"
        >
      </div>
    </div>

    <div class="contact-form__field">
      <label
        class="contact-form__label"
        for="ContactForm-phone"
      >
        {{- 'blocks.contact_form.phone' | t -}}
      </label>
      <input
        type="tel"
        id="ContactForm-phone"
        class="contact-form__input"
        autocomplete="tel"
        name="contact[phone]"
        pattern="[0-9\+\-\s\(\)]*"
        value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
        placeholder="{{ 'blocks.contact_form.phone' | t }}"
      >
    </div>

    <div class="contact-form__field">
      <label
        class="contact-form__label"
        for="ContactForm-body"
      >
        {{- 'blocks.contact_form.comment' | t -}}
      </label>
      <textarea
        rows="5"
        id="ContactForm-body"
        class="contact-form__input contact-form__input--textarea"
        name="contact[body]"
        placeholder="{{ 'blocks.contact_form.comment' | t }}"
      >{{- form.body -}}</textarea>
    </div>

    <div class="contact-form__footer">
      <p class="contact-form__note">
        <span class="contact-form__required" aria-hidden="true">*</span>
        Required field &middot; Replies within 24 hours
      </p>
      {{ submit_button }}
    </div>
  {%- endform -%}
</div>

{% stylesheet %}
  @keyframes contactFormFadeUp {
    from {
      opacity: 0;
      transform: translateY(22px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-form {
    --contact-form-sans: 'Plus Jakarta Sans', var(--font-body--family), sans-serif;
    --contact-form-ease: cubic-bezier(0.22, 1, 0.36, 1);

    font-family: var(--contact-form-sans);
    max-width: 860px;
    margin-inline: auto;
  }

  .contact-form__form {
    position: relative;
    overflow: hidden;
    background-color: var(--color-input-background);
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.78) 0%, rgba(255, 250, 235, 0.42) 100%);
    border: 1px solid rgb(from var(--color-primary) r g b / 0.22);
    border-radius: 24px;
    padding: 28px 20px;
    box-shadow: 0 18px 46px rgb(from var(--color-shadow) r g b / 0.07);
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition:
      border-color 0.35s var(--contact-form-ease),
      box-shadow 0.35s var(--contact-form-ease);

    @media screen and (width >= 750px) {
      padding: 40px 46px;
      gap: 22px;
    }
  }

  .contact-form__form::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent 8%, #d6a86e 30%, var(--color-primary) 50%, #d6a86e 70%, transparent 92%);
  }

  .contact-form__form:focus-within {
    border-color: rgb(from var(--color-primary) r g b / 0.48);
    box-shadow: 0 22px 52px rgb(from var(--color-primary) r g b / 0.12);
  }

  @media (prefers-reduced-motion: no-preference) {
    .contact-form__form {
      animation: contactFormFadeUp 0.75s var(--contact-form-ease) both;
      animation-delay: 0.15s;
    }
  }

  .contact-form__form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;

    @media screen and (width >= 750px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 100%;
    text-align: left;
  }

  .contact-form__label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--contact-form-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-heading);
  }

  .contact-form__required {
    color: var(--color-primary);
    font-weight: 700;
  }

  .contact-form__input {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-foreground);
    background-color: var(--color-background);
    padding: 13px 16px;
    font-family: var(--contact-form-sans);
    font-size: 0.9375rem;
    line-height: 1.5;
    border-radius: 12px;
    border: 1.5px solid rgb(from var(--color-primary) r g b / 0.22);
    -webkit-font-smoothing: antialiased;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s var(--contact-form-ease);
  }

  .contact-form__input::placeholder {
    color: rgb(from var(--color-foreground) r g b / 0.45);
  }

  .contact-form__input:hover {
    border-color: rgb(from var(--color-primary) r g b / 0.55);
    background-color: var(--color-input-background);
  }

  .contact-form__input:focus {
    outline: none;
    border-color: var(--color-primary);
    background-color: var(--color-input-background);
    box-shadow: 0 0 0 4px rgb(from var(--color-primary) r g b / 0.12);
    transform: translateY(-1px);
  }

  .contact-form__input--textarea {
    overflow: auto;
    resize: vertical;
    min-height: 136px;
    max-height: 320px;
  }

  .contact-form__footer {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 18px;
    border-top: 1px solid rgb(from var(--color-primary) r g b / 0.16);

    @media screen and (width >= 750px) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .contact-form__note {
    margin: 0;
    font-family: var(--contact-form-sans);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(from var(--color-foreground) r g b / 0.65);
    text-align: left;
  }

  .contact-form .submit-button.button:not(.button-secondary, .button-unstyled) {
    position: relative;
    overflow: hidden;
    background-color: var(--color-primary);
    background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(0, 0, 0, 0.08) 100%);
    color: var(--color-primary-button-text);
    border: 1.5px solid var(--color-primary);
    border-radius: 999px;
    min-height: var(--minimum-touch-target);
    min-width: 210px;
    padding: 13px 32px;
    font-family: var(--contact-form-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 8px 22px rgb(from var(--color-primary) r g b / 0.24);
    transition:
      transform 0.3s var(--contact-form-ease),
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;

    @media screen and (width < 750px) {
      width: 100%;
    }
  }

  .contact-form .submit-button.button:not(.button-secondary, .button-unstyled)::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: -120%;
    width: 65%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
    transform: skewX(-20deg);
    transition: inset-inline-start 0.6s var(--contact-form-ease);
  }

  .contact-form .submit-button.button:not(.button-secondary, .button-unstyled):hover::after {
    inset-inline-start: 140%;
  }

  .contact-form .submit-button.button:not(.button-secondary, .button-unstyled):hover {
    transform: translateY(-2px);
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    color: var(--color-primary-button-hover-text);
    box-shadow: 0 12px 28px rgb(from var(--color-shadow) r g b / 0.18);
  }

  .contact-form__error,
  .contact-form__success {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 0.875rem;
    line-height: 1.5;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
  }

  .contact-form__error {
    color: var(--color-error);
    border-left: 3px solid var(--color-error);
  }

  .contact-form__success {
    color: var(--color-success);
    border-left: 3px solid var(--color-success);
  }

  .contact-form__error svg,
  .contact-form__success svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
{% endstylesheet %}
