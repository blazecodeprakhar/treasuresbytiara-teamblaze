{%- liquid
  assign wa_enabled = settings.whatsapp_float_enabled
  if wa_enabled == nil
    assign wa_enabled = true
  endif

  assign wa_raw = settings.whatsapp_float_number | default: '+91 98675 59430' | strip
  assign wa_digits = wa_raw | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign wa_label = settings.whatsapp_float_label | default: 'Chat with us' | strip
  assign wa_msg = settings.whatsapp_float_message | default: 'Hi Treasures by Tiara! I would love some help with a piece.' | strip | url_encode

  assign wa_href = 'https://wa.me/' | append: wa_digits
  if wa_msg != blank
    assign wa_href = wa_href | append: '?text=' | append: wa_msg
  endif
-%}

{%- if wa_enabled and wa_digits != blank -%}
  <a
    href="{{ wa_href }}"
    target="_blank"
    rel="noopener noreferrer"
    class="wa-float"
    aria-label="Chat on WhatsApp"
  >
    <span class="wa-float__pulse" aria-hidden="true"></span>
    <span class="wa-float__icon" aria-hidden="true">
      <svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        {% render 'icon', icon: 'whatsapp' %}
      </svg>
    </span>
    {%- if wa_label != blank -%}
      <span class="wa-float__label">{{ wa_label | escape }}</span>
    {%- endif -%}
  </a>
{%- endif -%}

{% stylesheet %}
  @keyframes waFloatPulse {
    0% {
      transform: scale(1);
      opacity: 0.45;
    }

    70% {
      transform: scale(1.22);
      opacity: 0;
    }

    100% {
      transform: scale(1.22);
      opacity: 0;
    }
  }

  .wa-float {
    position: fixed;
    inset-block-end: 22px;
    inset-inline-end: 22px;
    z-index: 15;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 50px;
    padding: 8px 18px 8px 10px;
    border-radius: 999px;
    background: linear-gradient(135deg, #1b8a4b 0%, #146c3a 100%);
    color: #ffffff;
    border: 1.5px solid rgba(255, 255, 255, 0.36);
    box-shadow:
      0 12px 28px rgba(20, 108, 58, 0.3),
      0 0 0 1px rgba(166, 123, 0, 0.25);
    text-decoration: none;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease,
      background 0.3s ease;
  }

  .wa-float:hover {
    transform: translateY(-3px) scale(1.02);
    color: #ffffff;
    box-shadow:
      0 16px 34px rgba(20, 108, 58, 0.38),
      0 0 0 1.5px rgba(214, 168, 110, 0.6);
  }

  .wa-float__pulse {
    position: absolute;
    inset: -2px;
    border-radius: 999px;
    border: 2px solid rgba(27, 138, 75, 0.55);
    pointer-events: none;
    animation: waFloatPulse 2.8s ease-out infinite;
  }

  .wa-float__icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.16);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .wa-float__icon svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .wa-float__label {
    white-space: nowrap;
    line-height: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float__pulse {
      animation: none;
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .wa-float {
      inset-block-end: 16px;
      inset-inline-end: 16px;
      width: 52px;
      height: 52px;
      min-height: 52px;
      padding: 0;
      justify-content: center;
    }

    .wa-float__label {
      display: none;
    }

    .wa-float__icon {
      width: 100%;
      height: 100%;
      background-color: transparent;
    }

    .wa-float__icon svg {
      width: 24px;
      height: 24px;
    }
  }

  @media print {
    .wa-float {
      display: none;
    }
  }
{% endstylesheet %}
