{%- liquid
  assign wa_enabled = true
  if settings.whatsapp_float_enabled == false
    assign wa_enabled = false
  endif

  assign wa_raw = settings.whatsapp_float_number | default: '+91 98675 59430' | strip
  assign wa_digits = wa_raw | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign wa_label = settings.whatsapp_float_label | default: 'Chat with us' | strip
  assign wa_msg = settings.whatsapp_float_message | default: 'Hi Treasures by Tiara! I would love some help with a piece.' | strip | url_encode

  assign wa_href = 'https://wa.me/' | append: wa_digits
  if wa_msg != blank
    assign wa_href = wa_href | append: '?text=' | append: wa_msg
  endif
-%}

{%- if wa_enabled and wa_digits != blank -%}
  <a
    href="{{ wa_href }}"
    target="_blank"
    rel="noopener noreferrer"
    class="wa-float"
    aria-label="Chat on WhatsApp"
  >
    <span class="wa-float__pulse" aria-hidden="true"></span>
    <span class="wa-float__icon" aria-hidden="true">
      <svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        {% render 'icon', icon: 'whatsapp' %}
      </svg>
    </span>
    {%- if wa_label != blank -%}
      <span class="wa-float__label">{{ wa_label | escape }}</span>
    {%- endif -%}
  </a>
{%- endif -%}
